# ---------------------------------------------------------------------------
# Olympiad Portal — environment template
#
# Copy this file to `.env.local` in the repository root and fill in real
# values. Ask the development team for the shared Supabase testing keys.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# PostgreSQL connection string used by Drizzle ORM (required)
DATABASE_URL=postgres://user:password@host:5432/postgres

# Public base URL used to build links in emails and cron callbacks
# (optional — defaults to http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Shared secret expected by the round-scheduler webhook (Vercel Cron)
CRON_SECRET=generate-a-random-secret

# Supabase service-role key — required for marked-script storage uploads
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email delivery over SMTP (e.g. Brevo). When host/user/pass are unset,
# outgoing email is skipped and logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Olympiad Portal <no-reply@example.com>"

# Reminder timing. Days and hours are added together, so days=0 + hours=1
# means "within the last hour". The hourly sweep sends:
# - opening reminder 1 day before a round's opensAt
# - closing reminder 1 hour before a round's closesAt
# - overdue follow-up 2 days after a round's closesAt (missing submissions)
# - results-out emails when the organiser publishes results
REMINDER_OPENING_WINDOW_DAYS=1
REMINDER_OPENING_WINDOW_HOURS=0
REMINDER_CLOSING_WINDOW_DAYS=0
REMINDER_CLOSING_WINDOW_HOURS=1
REMINDER_OVERDUE_AFTER_DAYS=2
REMINDER_RESULTS_CATCHUP_DAYS=14

# Google Gemini API key — enables AI question extraction from PDFs (optional)
GEMINI_API_KEY=

# High-schools directory API — used only by `npm run fetch:schools` (optional)
HIGH_SCHOOLS_API_BASE_URL=https://api.labs.org.za
HIGH_SCHOOLS_API_TOKEN=
