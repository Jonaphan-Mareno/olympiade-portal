# Copy this file to .env.local and fill in the values.
# On hosted environments (e.g. Vercel), set these in the project's
# Environment Variables settings instead.

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string (Supabase Dashboard -> Database -> Connect)
DATABASE_URL=

# Base URL of the hosted site, used to build links inside emails
# e.g. https://olympiad-portal-eta.vercel.app
NEXT_PUBLIC_BASE_URL=

# Email sending — SMTP credentials (e.g. Brevo: smtp-relay.brevo.com:587).
# If SMTP_HOST/SMTP_USER/SMTP_PASS are unset, emails fall back to Ethereal
# test accounts (captured for preview, not actually delivered).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender address shown in emails. Must be verified with your SMTP provider.
# Optionally include a display name: '"Olympiad Portal" <you@example.com>'
EMAIL_FROM=
